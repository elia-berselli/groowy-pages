---
import { getEntry } from 'astro:content';
import GuideArticle from '../components/GuideArticle.astro';

const guide = await getEntry('guides', 'it/spese');
if (!guide) throw new Error('Guida italiana spese non trovata');
const alternatePaths = { it: guide.data.canonicalPath, en: guide.data.alternatePath };
---

<GuideArticle {guide} {alternatePaths} />
