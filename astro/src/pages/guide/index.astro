---
import { getCollection } from 'astro:content';
import PublicLayout from '../../layouts/PublicLayout.astro';

const alternatePaths = { it: '/guide/', en: '/en/guides/' };
const guides = (await getCollection('guides', ({ data }) => data.locale === 'it' && data.indexing === 'index'))
  .sort((first, second) => first.data.order - second.data.order);
---

<PublicLayout
  lang="it"
  title="Guide per finanze personali più chiare"
  description="Guide Groowy su spese, documenti, budget familiare e privacy offline: poche risorse pratiche, senza promesse automatiche."
  canonicalPath="/guide/"
  {alternatePaths}
>
  <article class="prose guide-hub">
    <p class="eyebrow">Guide Groowy</p>
    <h1>Poche guide per decidere con più chiarezza.</h1>
    <p class="lead">Queste pagine partono da problemi quotidiani, non da keyword ripetute: registrare le spese, ordinare documenti, costruire un budget condiviso e capire i confini dei dati.</p>
    <div class="guide-grid">
      {guides.map((guide) => (
        <article class="guide-card">
          <p class="eyebrow">{guide.data.eyebrow}</p>
          <h2><a href={guide.data.canonicalPath}>{guide.data.title}</a></h2>
          <p>{guide.data.description}</p>
          <a class="text-link" href={guide.data.canonicalPath}>Apri la guida <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
    <aside class="guide-status">
      <p class="eyebrow">Partner · roadmap</p>
      <h2>API bancarie: prima il perimetro, poi la connessione.</h2>
      <p>Le future partnership AIS saranno solo in lettura e non sono disponibili oggi. La pagina partner spiega cosa Groowy chiederà a un eventuale provider, senza nominare banche o partnership non verificate.</p>
      <a class="text-link" href="/partners/open-banking/">Leggi il perimetro AIS read-only <span aria-hidden="true">→</span></a>
    </aside>
  </article>
</PublicLayout>
