---
import { getCollection } from 'astro:content';
import PublicLayout from '../../../layouts/PublicLayout.astro';

const alternatePaths = { it: '/guide/', en: '/en/guides/' };
const guides = (await getCollection('guides', ({ data }) => data.locale === 'en' && data.indexing === 'index'))
  .sort((first, second) => first.data.order - second.data.order);
---

<PublicLayout
  lang="en"
  title="Guides for clearer personal finance"
  description="Groowy guides on spending, documents, family budgets and offline privacy: a few practical resources without automated promises."
  canonicalPath="/en/guides/"
  {alternatePaths}
>
  <article class="prose guide-hub">
    <p class="eyebrow">Groowy guides</p>
    <h1>A few guides for clearer decisions.</h1>
    <p class="lead">These pages begin with everyday problems, not repeated keywords: recording spending, organising documents, building a shared budget and understanding data boundaries.</p>
    <div class="guide-grid">
      {guides.map((guide) => (
        <article class="guide-card">
          <p class="eyebrow">{guide.data.eyebrow}</p>
          <h2><a href={guide.data.canonicalPath}>{guide.data.title}</a></h2>
          <p>{guide.data.description}</p>
          <a class="text-link" href={guide.data.canonicalPath}>Open guide <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
    <aside class="guide-status">
      <p class="eyebrow">Partners · roadmap</p>
      <h2>Bank APIs: scope first, connection second.</h2>
      <p>Possible future AIS partnerships will be read-only and are not available today. The partner page explains what Groowy would ask of a provider without naming banks or unverified partnerships.</p>
      <a class="text-link" href="/en/partners/open-banking/">Read the read-only AIS perimeter <span aria-hidden="true">→</span></a>
    </aside>
  </article>
</PublicLayout>
