---
import { getEntry } from 'astro:content';
import GuideArticle from '../../components/GuideArticle.astro';

const guide = await getEntry('guides', 'en/offline-privacy');
if (!guide) throw new Error('English offline privacy guide not found');
const alternatePaths = { it: guide.data.alternatePath, en: guide.data.canonicalPath };
---

<GuideArticle {guide} {alternatePaths} />
