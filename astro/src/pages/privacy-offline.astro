---
import { getEntry } from 'astro:content';
import GuideArticle from '../components/GuideArticle.astro';

const guide = await getEntry('guides', 'it/privacy-offline');
if (!guide) throw new Error('Guida italiana privacy offline non trovata');
const alternatePaths = { it: guide.data.canonicalPath, en: guide.data.alternatePath };
---

<GuideArticle {guide} {alternatePaths} />
